class VocabularyCreatorParams:
	"Parameters for [VocabularyCreator]"
	k: int
	"Branching factor"
	L: int | None
	"Maximum tree depth"
	max_iters: int
	"Number of k-means iterations"
	nthreads: int
	"Number of threads to use while computing"
	verbose: bool
	def __init__(self, k: int = 32, L: int | None = None, max_iters: int = 11, nthreads: int = 1, verbose: bool = False): ...
	def effective_threads(self) -> int: ...
	def __str__(self) -> str: ...
	def __repr__(self) -> str: ...
	def __eq__(self, value, /) -> bool: ...
	def __ne__(self, value, /) -> bool: ...
	def __hash__(self) -> int: ...

class VocabularyCreator:
	"Helper to create a [Vocabulary]"
