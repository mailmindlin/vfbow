		"Normalize such that `fbow.normalize().norm() == 1.0`"
		...
	def to_dict(self) -> dict[int, float]:
		"Convert to native Python dict"
		...

class _FeaturesKeys(_PyDictView):
	def __iter__(self) -> Iterator[int]: ...
	def to_list(self, sorted: bool = False) -> list[int]: ...
	def to_numpy(self, sorted: bool = False) -> np.ndarray[tuple[int], np.dtype[np.uint32]]: ...

class _FeaturesValues(_PyDictView):
	def __iter__(self) -> Iterator[list[int]]: ...
	def to_list(self, sorted: bool = False) -> list[list[int]]: ...
	def to_numpy(self, sorted: bool = False) -> np.ndarray[tuple[int], np.dtype[np.uint32]]: ...

class _FeaturesItems(_PyDictView):
	def __iter__(self) -> Iterator[tuple[int, list[int]]]: ...
	def to_list(self, sorted: bool = False) -> list[int]: ...
	def to_numpy(self, sorted: bool = False) -> np.ndarray[tuple[int], np.dtype[np.uint32]]: ...

class _IntersectFeatures:
	"Intersection of features"
	def __bool__(self) -> int: ...
	def __len__(self) -> int: ...
	def keys(self) -> list[int]: ...
	def values(self) -> list[tuple[list[int], ...]]: ...
	def __iter__(self) -> Iterator[tuple[int, tuple[list[int], ...]]]: ...
	def __and__(self, other: 'Features | _IntersectFeatures') -> _IntersectFeatures: ...

class Features:
	"""
	Bag of words with augmented information.

	For each word, keeps information about the indices of the elements that have been classified into the word.
	It is computed at the desired level
	"""
	def __bool__(self) -> bool: ...
	def __len__(self) -> int: ...
	def __repr__(self) -> str: ...
	def __hash__(self) -> int: ...

	def __getitem__(self, key: int) -> list[int]: ...
	def __contains__(self, key: int) -> bool: ...
	def get[T](self, key: int, default: T) -> list[int] | T: ...
	
	def keys(self) -> _FeaturesKeys: ...
	def values(self) -> _FeaturesValues: ...
	def items(self) -> _FeaturesItems: ...
	def to_dict(self) -> dict[int, list[int]]: ...

	def __and__(self, other: 'Features | _IntersectFeatures') -> _IntersectFeatures: ...

class ParseValidationMode(Enum):
	Ignore = auto()
	"Silently accept invalid data"
	Warn = auto()
	"Print a message to stdout"
	Strict = auto()
	"Return an error on invalid data"

