	def get[T](self, key: int, default: T) -> float | T: ...
	def __getitem__(self, key: int) -> float: ...

	def score(self, other: 'Bow', metric: Scoring = Scoring.L2) -> float:
		"Compute the score between this and some other bag of words"
		...
	def norm(self, norm: LNorm = LNorm.L2) -> float:
		"Compute the Ln norm of all the scores"
		...
