import typing
import pathlib
import numpy as np
from collections.abc import Sequence, Iterator
from enum import Enum, auto

type _IO = str | pathlib.Path | typing.BinaryIO

type _FeatureU8[F: int] = np.ndarray[tuple[int, F], np.dtype[np.uint8]]
type _FeatureF32[F: int] = np.ndarray[tuple[int, F], np.dtype[np.uint8]]

class LNorm(Enum):
	L1 = auto()
	"L1 norm (manhattan distance)"
	L2 = auto()
	"L2 norm (euclidean distance)"

class Scoring(Enum):
	L1 = auto()
	L2 = auto()
	ChiSquare = auto()
	KL = auto()
	Bhattacharyya = auto()
	DotProduct = auto()

class _PyDictView:
	def __bool__(self) -> bool: ...
	def __len__(self) -> int: ...
	def __repr__(self) -> str: ...

class _BowKeys(_PyDictView):
	def __iter__(self) -> Iterator[int]: ...
	def to_list(self, sorted: bool = False) -> list[int]: ...
	def to_numpy(self, sorted: bool = False) -> np.ndarray[tuple[int], np.dtype[np.uint32]]: ...

class _BowValues(_PyDictView):
	def __iter__(self) -> Iterator[float]: ...
	def to_list(self, sorted: bool = False) -> list[int]: ...
	def to_numpy(self, sorted: bool = False) -> np.ndarray[tuple[int], np.dtype[np.uint32]]: ...

class _BowItems(_PyDictView):
	def __iter__(self) -> Iterator[tuple[int, float]]: ...
	def to_list(self, sorted: bool = False) -> list[int]: ...
	def to_numpy(self, sorted: bool = False) -> np.ndarray[tuple[int], np.dtype[np.uint32]]: ...

class Bow:
	"Bag of words"
	def __bool__(self) -> bool: ...
	def __len__(self) -> int: ...
	def __repr__(self) -> str: ...
	def __hash__(self) -> int: ...
	def __contains__(self, key: int) -> bool: ...

	def keys(self) -> _BowKeys: ...
	def values(self) -> _BowValues: ...
